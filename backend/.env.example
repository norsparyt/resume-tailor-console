# Optional. Every setting has a default, so the backend runs without a .env file.
# No API key is needed: the app never calls an AI service.

# pdflatex | xelatex | lualatex | tectonic
LATEX_ENGINE=pdflatex
LATEX_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:3000
